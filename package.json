{
  "name": "elmars-app",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@hq/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:tools",
    "test:tools": "node --test tools/release-lib.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "release": "node tools/release.mjs"
  }
}
