{
  "name": "elmars-app",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@hq/web",
    "build": "npm run build --workspaces --if-present",
