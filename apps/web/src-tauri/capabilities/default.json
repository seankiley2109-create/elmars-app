{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: read and write the notes folder under the home folder, choose a folder, reveal it in Finder, open an attached file in place with its default app, and open web and mail links (http, https, mailto only). On macOS the fs scope never matches a hidden (dot) path component unless a pattern names it literally, so the hidden names the app needs are listed explicitly; nothing else hidden (~/.ssh and so on) is reachable.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }, { "path": "$HOME/**/.activity" }, { "path": "$HOME/**/.activity/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/**/.*.icloud" }, { "path": "$HOME/**/.activity/.*.icloud" }]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http:*" }, { "url": "https:*" }, { "url": "mailto:*" }]
    }
  ]
}
