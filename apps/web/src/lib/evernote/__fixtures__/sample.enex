  <note>
    <title>Formatting tour</title>
    <created>20231014T091500Z</created>
    <updated>20231015T183045Z</updated>
    <tag>work</tag>
    <tag>reference</tag>
    <note-attributes>
      <author>Elmar</author>
    </note-attributes>
    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
<en-note>
<h1>Heading one</h1>
<h2>Heading two</h2>
<h3>Heading three</h3>
<h4>Heading four</h4>
<h5>Heading five</h5>
<h6>Heading six</h6>
<p>A paragraph with <b>bold</b>, <strong>strong</strong>, <i>italic</i>, <em>emphasis</em> and <u>underlined</u> words.</p>
<div>First line<br/>Second line</div>
<div>See <a href="https://example.com/docs">the docs</a> for more.</div>
<div><span style="color:#ff0000;font-weight:bold">Red span</span> and <font color="blue" face="Courier">blue font</font> text.</div>
<div><en-todo checked="false"/>Call the plumber</div>
<div><en-todo checked="true"/>Pay the rent</div>
<table><tr><th>Item</th><th>Qty</th></tr><tr><td>Eggs</td><td>12</td></tr></table>
<ul><li>Apples</li><li>Pears<ul><li>Conference</li><li>Williams</li></ul></li></ul>
<ol><li>First</li><li>Second<ol><li>Second A</li></ol></li></ol>
<hr/>
<div>The end.</div>
</en-note>]]>
    </content>
  </note>
